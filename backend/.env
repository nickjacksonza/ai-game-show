# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3055

# Database
DATABASE_PATH=./data/ai-game-show.db

# Security (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-random-32-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-string
ENCRYPTION_MASTER_KEY=change-me-to-32-char-encryption-key

# OAuth - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
